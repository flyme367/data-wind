{
  "name": "data-wind-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "oxlint --ignore-path .oxlintignore src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare:models": "node scripts/prepare-gis.mjs && node scripts/prepare-models.mjs",
    "generate:protocol": "node scripts/generate-protocol.mjs",
    "check:protocol": "node scripts/generate-protocol.mjs --check",
    "test:protocol:wasm": "node scripts/test-protocol-wasm.mjs",
    "test:water:wasm": "node scripts/test-water-wasm.mjs",
    "test:terrain:wasm": "node scripts/test-terrain-wasm.mjs",
    "test:board:wasm": "node scripts/test-board-wasm.mjs",
    "thumbs:map": "node --experimental-websocket scripts/generate-map-thumbs.mjs",
    "test:rayon:workers": "node --test scripts/rayon-worker-helpers.test.mjs",
    "build:engine": "node scripts/build-engine.mjs",
    "build:engine:single": "node scripts/build-engine.mjs --single",
    "build:engine:parallel": "node scripts/build-engine.mjs --parallel",
    "build:model-importer": "node scripts/build-model-importer.mjs",
    "generate:model-protocol": "node scripts/generate-model-protocol.mjs",
    "check:model-protocol": "node scripts/generate-model-protocol.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@icon-park/react": "^1.4.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "fflate": "^0.8.3",
    "flatbuffers": "25.9.23",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.66.0",
    "mpegts.js": "^1.8.2",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.5.438",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.14",
    "shadcn": "^4.23.0",
    "socket.io-client": "^4.8.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.15.30",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.7",
    "oxlint": "^1.90.0",
    "pngjs": "7.0.0",
    "socket.io": "^4.8.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
